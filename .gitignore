# ==============================================================================
# Git Ignore Configuration for Karnataka Rainfall Project (GitHub-Ready)
# ==============================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
myvenv/
tf_env/
env.bak/
venv.bak/

# --- Environment Variables, Tokens & Secrets ---
.env
.env.*
!.env.example
.cdsapirc
credentials.json
token.json

# --- Testing, Linting & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/

# --- IDEs, Text Editors & OS Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# --- Logs & Temporary Directories ---
*.log
logs/
tmp/
temp/

# --- Model Binaries, Weights & Checkpoints ---
*.h5
*.keras
*.pth
*.pt
*.ckpt
*.onnx
*.bin
*.joblib
*.pkl

# ==============================================================================
# Large Datasets & Storage (Strictly exceeds GitHub 100 MB Limit)
# ==============================================================================
